# Salin file ini menjadi .env.local, lalu isi nilainya.
#
# Tidak ada satu pun variabel berawalan NEXT_PUBLIC_ di sini, dan itu disengaja:
# browser tidak pernah berbicara langsung ke Supabase. Semua query lewat server.

# Supabase — ambil dari Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kunci penanda tangan cookie sesi. Minimal 32 karakter acak.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
