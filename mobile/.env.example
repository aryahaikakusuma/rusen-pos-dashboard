# Salin file ini menjadi mobile/.env.
#
# Hanya kunci publik yang boleh ada di sini. Awalan EXPO_PUBLIC_ membuat nilainya
# ikut ter-inline ke dalam bundel JavaScript — siapa pun yang membongkar APK bisa
# membacanya. Untuk anon key itu memang tidak masalah: tanpa token dari
# `pin-login`, anon key tidak punya hak apa pun (lihat migrasi 0003).
#
# SERVICE_ROLE_KEY TIDAK BOLEH DITARUH DI SINI, dalam bentuk apa pun. Kunci itu
# melewati RLS dan akan memberi akses penuh ke database kepada siapa saja yang
# mengekstraknya dari aplikasi.

# Bukan 127.0.0.1: HP adalah perangkat lain, jadi ia butuh alamat LAN komputer
# yang menjalankan Supabase. Cek dengan `ipconfig`, dan pastikan HP berada di
# Wi-Fi yang sama.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321

# Lokal   : ambil ANON_KEY dari output `supabase status`
# Produksi: Project Settings > API > anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=
