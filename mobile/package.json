{
  "name": "rusen-pos-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.11",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --go --android",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "periksa:varian": "tsc scripts/periksa-varian.ts lib/product-variants.ts --ignoreConfig --outDir node_modules/.cache/periksa-varian --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck && node node_modules/.cache/periksa-varian/scripts/periksa-varian.js",
    "preview:struk": "tsc scripts/preview-receipt.ts --ignoreConfig --types node --outDir node_modules/.cache/preview-struk --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck && node node_modules/.cache/preview-struk/scripts/preview-receipt.js"
  },
  "private": true
}
