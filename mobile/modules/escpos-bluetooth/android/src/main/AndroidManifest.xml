<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Izin diletakkan di manifest modul, bukan di app.json, dengan sengaja:
    izin ini ada KARENA modul ini. Modul dihapus, izinnya ikut hilang, dan
    tidak ada baris yatim yang tertinggal di app.json tanpa ada yang tahu
    untuk apa. Manifest merger menggabungkannya ke APK saat prebuild.

    Yang TIDAK ada di sini juga disengaja: BLUETOOTH_SCAN dan
    ACCESS_FINE_LOCATION. Keduanya untuk menemukan perangkat baru, sedangkan
    printer dipasangkan lewat Pengaturan Android dan aplikasi hanya membaca
    daftar yang sudah terpasang. Meminta izin memindai berarti meminta hak
    yang tidak pernah dipakai.
  -->

  <!-- Android 12 (API 31) ke atas: izin runtime, harus diminta juga saat jalan. -->
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- Android 11 ke bawah: izin pasang, tidak ada permintaan runtime. -->
  <uses-permission
      android:name="android.permission.BLUETOOTH"
      android:maxSdkVersion="30" />

  <!--
    required="false" supaya aplikasi tetap bisa dipasang di perangkat tanpa
    Bluetooth. Kasir yang tidak punya printer masih harus bisa mencatat order.
  -->
  <uses-feature
      android:name="android.hardware.bluetooth"
      android:required="false" />

</manifest>
