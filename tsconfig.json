{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // supabase/functions berjalan di Deno, bukan Node: ia meng-import lewat
  // penentu `npm:` dan memakai global `Deno`, keduanya tidak dikenal tsc di
  // sini. Memasukkannya membuat `npm run typecheck` selalu merah karena
  // kesalahan yang bukan kesalahan — dan pemeriksaan yang selalu merah sama
  // saja dengan tidak ada pemeriksaan.
  "exclude": ["node_modules", "supabase/functions"]
}
